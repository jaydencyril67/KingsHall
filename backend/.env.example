# Copy these into the backend host's environment settings. Never commit real values.
NODE_ENV=production
PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret
RESEND_API_KEY=re_...
EMAIL_FROM=KingsHall <verify@your-verified-domain.example>
APP_BASE_URL=https://your-kingshall-site.example
CLIENT_ORIGINS=https://your-kingshall-site.example,https://localhost,capacitor://localhost,http://localhost:5173
EMAIL_CODE_TTL_MINUTES=10
EMAIL_RESEND_COOLDOWN_SECONDS=60
